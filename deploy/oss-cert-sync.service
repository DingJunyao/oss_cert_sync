[Unit]
Description=Push Caddy TLS certificates to Aliyun OSS CNAME domains
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run as an unprivileged user that can 'docker exec' the Caddy container:
#User=ecs-user
#Group=ecs-user
# Credentials for OSS (chmod 600 this file, owner = the User above):
EnvironmentFile=-/etc/oss-cert-sync/env
ExecStart=/opt/oss-cert-sync/bin/oss-cert-sync sync --config /etc/oss-cert-sync/config.toml
# State/lock default next to the config; keep them writable by User.
